# Copy this file to .env.local and fill only the keys you want to test.
# .env.local is gitignored. Do not commit real secrets.

# Required for chat/RAG and Sarvam cascade LLM step.
GROQ_API_KEY=

# Required only when testing OpenAI Realtime or OpenAI STT/TTS fallback routes.
OPENAI_API_KEY=

# Required when LIVE_VOICE_ENGINE=sarvam_cascade or STT/TTS_PROVIDER=sarvam.
SARVAM_API_KEY=

# Voice engine: openai_realtime or sarvam_cascade.
LIVE_VOICE_ENGINE=sarvam_cascade

# Shared voice preview budget. Keep this low while testing if needed.
VOICE_DAILY_IP_BUDGET_MS=120000

# Sarvam defaults.
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_STT_LANGUAGE=unknown
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_OUTPUT_CODEC=wav

# Optional Langfuse local tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
